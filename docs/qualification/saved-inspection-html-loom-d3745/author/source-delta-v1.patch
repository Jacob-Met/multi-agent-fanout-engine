+
+def _table(caption: str, rows: list[tuple[str, Any, Any]]) -> str:
+    out = ['<table class="comparison"><caption>', caption,
+           '</caption><thead><tr><th scope="col">Field</th><th scope="col">First</th>',
+           '<th scope="col">Second</th></tr></thead><tbody>']
